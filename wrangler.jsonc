{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stock-scannet-pro",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
